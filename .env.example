# Do not commit your actual .env file to Git! This may contain secrets or other
# private information.

# Enable/disable step debug logging (default: `false`). For local debugging, it
# may be useful to set it to `true`.
ACTIONS_STEP_DEBUG=true

# GitHub Actions inputs should follow `INPUT_<name>` format (case-sensitive).
# Hyphens should not be converted to underscores!

# Required: GitHub team to randomly select a user from
# Format: "org/team-slug" or just "team-slug" (uses repo owner as org)
INPUT_github_team=my-org/my-team

# Required: GitHub token with permissions to read team members and assign PRs
# Create a token at https://github.com/settings/tokens with scopes:
#   - read:org (to list team members)
#   - repo (to assign PRs)
INPUT_github_token=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub Actions default environment variables. These are set for every run of a
# workflow and can be used in your actions. Setting the value here will override
# any value set by the local-action tool.
# https://docs.github.com/en/actions/learn-github-actions/variables#default-environment-variables

# Repository information (required for the action to work)
GITHUB_REPOSITORY=my-org/my-repo

# Path to the event payload JSON file (required for pull_request events)
# See .github/local-action/pull_request.json for an example payload
GITHUB_EVENT_PATH=.github/local-action/pull_request.json
GITHUB_EVENT_NAME=pull_request

